# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# N7: secrets come from the environment only.

# ── Readers [R7.5] TWO FAMILIES ARE MANDATORY ────────────────────────────────
# Family A (frontier, API). Family B (open-weight, local GPU) needs no key.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ── Judges [R8.2] at least two, with at least one independent of the reader ──
JUDGE_A_MODEL=claude-opus-5-5
JUDGE_B_MODEL=gpt-5.5
# A LOCAL judge is acceptable as the second family if budget is tight [R8.2].

# ── Embedder [R1.1] must be PINNED — an unnamed embedder is a confound ────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# ── Local reader #2 [R7.5] must fit in 8 GB VRAM ────────────────────────────
# A 7-8B model in bf16/fp16 fits; 32B does not. Verify with `make env`.
LOCAL_READER_MODEL=Qwen/Qwen3-8B
LOCAL_READER_DTYPE=bfloat16
LOCAL_READER_MAX_NEW_TOKENS=512

# ── Budget guard [R0.5][N4][N8] — a mismatch is a HARD ERROR, not a warning ─
# Must be re-agreed with the guide: the K x B grid is ~2-4x the 1-factor estimate.
MSAT_MAX_USD=0

# ── Concurrency [R5.3] affects latency, so it is a recorded variable ─────────
MSAT_MAX_CONCURRENCY=4
MSAT_RATE_LIMIT_RPM=60
