# Copy to .env and fill in. NEVER commit .env — it is gitignored.
# N7: secrets come from the environment only.
#
# ─────────────────────────────────────────────────────────────────────────────
# ⚠️ THERE IS NO PAID API IN THIS DESIGN.
#
# Every reader and every judge is a LOCAL open-weight model. That removes API
# cost and removes provider drift as a confound, at the price of a GPU wall-clock
# budget that now has to be measured (`msat design-power` reports the estimate).
#
# Consequence: there are NO API keys to put here. If you find yourself wanting to
# add one, the question to ask first is whether it is for a JUDGE (R8.2 wants at
# least one judge independent of the reader) or for convenience.
# ─────────────────────────────────────────────────────────────────────────────

# ── Local readers [R7.5] three families, ~9B each ────────────────────────────
# ⚠️ THE EXACT REPO IDS AND REVISION COMMITS BELOW MUST BE FILLED IN.
# `msat validate-config` FAILS until they are — PRD §R7.6 requires each reader's
# identity, version, and date, because an unnamed model makes every number in the
# paper unattributable. A tag like `main` is not enough: tags get repointed.
#
# To pin, run on the execution machine:
#   huggingface-cli download <repo> --revision <sha>
#   python -c "from huggingface_hub import model_info; \
#              print(model_info('<repo>').sha, model_info('<repo>').createdAt)"
#
# ⚠️ CONTEXT WINDOW IS A SCIENTIFIC CONSTRAINT, NOT A SETTING.
# The M-scale K=64 cell is a ~120k-token prompt (measured in P1: 4.84M characters
# per M question). A reader whose window is smaller CANNOT run those cells, and
# PRD §R3.2 forbids truncating the prompt to fit. `msat design-power` lists the
# infeasible cells; the grid must be trimmed BEFORE P5, not discovered during.
#
# ⚠️ 9B in bf16 is ~18 GB of weights against 8 GB of VRAM, so bf16 requires CPU
# offload into system RAM and runs several times slower. 4-bit is the default.

LOCAL_READER_GEMMA_MODEL=
LOCAL_READER_GEMMA_REVISION=
LOCAL_READER_GEMMA_CONTEXT_WINDOW=

LOCAL_READER_QWEN_MODEL=
LOCAL_READER_QWEN_REVISION=
LOCAL_READER_QWEN_CONTEXT_WINDOW=

LOCAL_READER_PHI_MODEL=
LOCAL_READER_PHI_REVISION=
LOCAL_READER_PHI_CONTEXT_WINDOW=

# ── Local judges [R8.2] at least two, at least one independent of the reader ─
# They are LOCAL. That makes the judge panel the largest single line item in the
# compute budget: 2 judges on ALL outputs, plus R8.6's two-pass replication.
JUDGE_1_MODEL=
JUDGE_2_MODEL=

# ── Embedder [R1.1] must be PINNED — an unnamed embedder is a confound ────────
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_REVISION=
EMBED_DIM=384

# ── Compute guard [N4] the real ceiling now that there is no USD ceiling ──────
# Hard wall-clock ceiling per run, enforced in the executor (P4). A $0 budget
# with an unestimated runtime is how a three-week compute bill arrives in week 8.
MSAT_MAX_WALL_CLOCK_HOURS=336
MSAT_DISK_BUDGET_BYTES=53687091200

# ── Concurrency [R5.3] affects latency, so it is a recorded variable ─────────
# ⚠️ On a single 8 GB consumer GPU, MSAT_MAX_CONCURRENCY > 1 is very likely to
# cause OOM during the M-scale cells, where one prompt is already ~120k tokens.
# Start at 1. Raise it only after measuring peak VRAM on the real grid.
MSAT_MAX_CONCURRENCY=1
